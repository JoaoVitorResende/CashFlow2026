## .gitignore para projetos .NET / Visual Studio

# =========================
# Visual Studio
# =========================
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# =========================
# Build results
# =========================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# =========================
# MSTest / Test results
# =========================
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# =========================
# NuGet
# =========================
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# =========================
# Rider / ReSharper
# =========================
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
_NCrunch*
*.dotCover

# =========================
# Arquivos de compilação / cache
# =========================
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# Guidance Automation Toolkit
*.gpState

# =========================
# Publish / Deploy
# =========================
publish/
*.Publish.xml
*.pubxml
*.pubxml.user
*.azurePubxml
*.publishsettings
PublishScripts/
ClientBin/

# =========================
# Azure / Cloud
# =========================
csx/
*.build.csdef
AppPackages/
ServiceFabricBackup/
*.rptproj.bak

# =========================
# Banco de dados local
# =========================
App_Data/*.mdf
App_Data/*.ldf
App_Data/*.sdf
sql/
*.Cache

# =========================
# Outros / relatórios de upgrade
# =========================
[Ss]tyle[Cc]op.*
!StyleCop.targets
~$*
*~
*.dbmdl
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
Generated_Code/

# =========================
# Windows / macOS
# =========================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# =========================
# Node / front-end (caso o projeto tenha)
# =========================
node_modules/
npm-debug.log*
yarn-error.log*

# =========================
# Segredos / configs locais
# =========================
appsettings.Development.json
appsettings.*.local.json
*.env